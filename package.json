{
  "name": "vietlott-checker",
  "version": "1.0.0",
  "description": "Tra cứu và đối chiếu vé Vietlott với lịch sử kết quả quay thưởng",
  "main": "server/index.js",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
